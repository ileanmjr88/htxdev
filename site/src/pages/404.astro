---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

// Referenced by wrangler.jsonc's not_found_handling: "404-page". Without this
// file that setting has nothing to serve and Cloudflare falls back to a bare
// status, so the config and the page have to land together.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Not found — htxdev</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="robots" content="noindex" />
    <script is:inline>
      try {
        const t = localStorage.getItem('htxdev-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>

  <body>
    <div class="mx-auto max-w-2xl px-5 pt-10 pb-16">
      <header class="flex items-center justify-between gap-4">
        <Wordmark as="a" class="text-xl sm:text-2xl" />
        <ThemeToggle />
      </header>

      <main class="mt-16">
        <h1 class="text-xl font-semibold tracking-tight sm:text-2xl">Nothing here</h1>
        <p class="mt-2 text-muted">
          That page does not exist. The events are on
          <a href="/" class="underline underline-offset-4">the front page</a>, and the
          same data is at
          <a href="/api/v1/events.json" class="underline underline-offset-4">
            <code>/api/v1/events.json</code></a>.
        </p>
      </main>
    </div>
  </body>
</html>
