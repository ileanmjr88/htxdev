---
import '../styles/global.css';
import EventCard from '../components/EventCard.astro';
import Wordmark from '../components/Wordmark.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { readEvents } from '../lib/events';

// Loaded from src/lib/events.ts, which this page and the /api/v1/events.json
// endpoint both use. The loader explains where it looks and why.
const data = readEvents();
const events = data.events;

// Every date and time on this page is rendered in America/Chicago, explicitly.
// The JSON carries UTC instants and a build machine is in whatever zone it
// feels like, so relying on the default would make the site show different
// days depending on where it was built. This is the same trap D10 describes on
// the Go side: an all-day event stored as midnight Chicago shows the previous
// date if it is ever rendered in UTC.
const TZ = 'America/Chicago';
const dayHeading = new Intl.DateTimeFormat('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', timeZone: TZ,
});
// en-CA gives YYYY-MM-DD, which is what makes these sortable and groupable.
const dayKey = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric', month: '2-digit', day: '2-digit', timeZone: TZ,
});

const days = [];
for (const event of events) {
  const key = dayKey.format(new Date(event.start));
  const last = days.at(-1);
  if (last?.key === key) last.events.push(event);
  else days.push({ key, label: dayHeading.format(new Date(event.start)), events: [event] });
}

// Jump targets. Computed here, not in the browser, so they are real anchors
// that work with JS off and with the page half-loaded.
//
// All the arithmetic runs on the YYYY-MM-DD keys through Date.UTC rather than
// on the event instants. The keys are already Chicago calendar dates, so
// treating them as UTC calendar dates keeps the maths in one timezone instead
// of converting twice and landing a day out. Same trap as D10, one layer up.
const asUTC = (key) => {
  const [y, m, d] = key.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, d));
};
// Monday of the week a key falls in. getUTCDay is 0 for Sunday, so shift it.
const weekStart = (key) => {
  const t = asUTC(key);
  const dow = (t.getUTCDay() + 6) % 7;
  t.setUTCDate(t.getUTCDate() - dow);
  return t.toISOString().slice(0, 10);
};
const todayKey = dayKey.format(new Date());
const thisWeek = weekStart(todayKey);
const nextWeekDate = asUTC(thisWeek);
nextWeekDate.setUTCDate(nextWeekDate.getUTCDate() + 7);
const nextWeek = nextWeekDate.toISOString().slice(0, 10);

const monthName = new Intl.DateTimeFormat('en-US', { month: 'long', timeZone: 'UTC' });

const jumps = [];
{
  // Only from today forward. A link to a week that has already happened is a
  // link to the top of the page wearing a date.
  const upcoming = days.filter((d) => d.key >= todayKey);
  const firstIn = (pred) => upcoming.find(pred)?.key;

  const tw = firstIn((d) => weekStart(d.key) === thisWeek);
  if (tw) jumps.push({ key: tw, label: 'This week' });
  const nw = firstIn((d) => weekStart(d.key) === nextWeek);
  if (nw) jumps.push({ key: nw, label: 'Next week' });

  // One per month that still has something in it, skipping any month whose
  // first remaining day is already a week link above, so the bar does not
  // carry two buttons that scroll to the same heading.
  const taken = new Set(jumps.map((j) => j.key));
  for (const m of [...new Set(upcoming.map((d) => d.key.slice(0, 7)))]) {
    const k = firstIn((d) => d.key.startsWith(m));
    if (k && !taken.has(k)) jumps.push({ key: k, label: monthName.format(asUTC(k)) });
  }
}

// Groups present in this build, most events first, for the filter chips. Built
// here rather than in the browser so the buttons and their counts are in the
// HTML: without JS you get the full list and no controls, which is the right
// fallback, and with JS nothing has to be measured before the page settles.
const groupCounts = new Map();
for (const e of events) {
  const g = groupCounts.get(e.group.slug) ?? { slug: e.group.slug, name: e.group.name, count: 0 };
  g.count++;
  groupCounts.set(e.group.slug, g);
}
const groups = [...groupCounts.values()].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const generated = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'medium', timeStyle: 'short', timeZone: TZ,
}).format(new Date(data.generated_at));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>htxdev — Houston tech events</title>
    <meta
      name="description"
      content="Houston tech meetups and events, collected from the groups that run them."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* A preview build carries unverified data and must never be indexed if it
        somehow gets deployed. */}
    {data.preview && <meta name="robots" content="noindex, nofollow" />}

    {/* Before first paint, deliberately. Setting the attribute from the toggle
        component instead would mean the page renders in one theme and then
        swaps, which is the flash every site with a theme switcher gets wrong
        at least once. Small enough to stay inline; a request for it would
        reintroduce the flash it exists to prevent. */}
    <script is:inline>
      try {
        const t = localStorage.getItem('htxdev-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>

  <body>
    <div class="mx-auto max-w-2xl px-5 pt-10 pb-16">
      <header>
        <div class="flex items-center justify-between gap-4">
          <Wordmark as="a" class="text-xl sm:text-2xl" />
          <ThemeToggle />
        </div>

        <h1 class="mt-8 text-xl font-semibold tracking-tight sm:text-2xl">Houston tech events</h1>
        <p class="mt-1 text-muted">
          Collected from the groups that run them, so you only have to look in one place.
        </p>
      </header>

      {data.preview && (
        <div class="mt-6 rounded-lg border border-warn bg-warn-bg px-4 py-3 text-sm">
          <strong class="mb-1 block">Preview build — not for publishing.</strong>
          This page includes events from groups nobody has verified yet. A group is verified
          by a human reading its feed once and putting their name in the group's file under <code>data/groups/</code>,
          and until that happens these events are not publishable.
        </div>
      )}

      {/* Jump links. Real anchors, so they work with JS off and before the
          filter script runs. scroll-mt-20 on each section keeps the heading
          clear of the sticky bar instead of under it.

          sticky rather than fixed: it takes part in the layout, so it never
          covers the footer on a short list, and on a filtered page that has
          collapsed to three events it simply scrolls away. */}
      {jumps.length > 1 && (
        <nav
          id="jumps"
          aria-label="Jump to a date"
          class="sticky top-0 z-10 -mx-5 mt-7 border-b border-line bg-bg/90 px-5 py-2 backdrop-blur"
        >
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[.8rem]">
            <span class="text-muted">Jump to</span>
            {jumps.map((j) => (
              <a href={`#day-${j.key}`} data-jump={j.key} class="text-accent hover:underline">{j.label}</a>
            ))}
          </div>
        </nav>
      )}

      {/* Filter by group rather than by category, deliberately. The category
          tags do no filtering work today: `startup` is 40 events and the Ion
          District feed is 40 events, so the tag is the feed wearing a
          different name. A group is a real attribute somebody verified.

          Plain buttons with aria-pressed, no framework. Without JS every event
          shows and the controls simply do nothing, which is the correct
          fallback for a static page whose whole point is the list. */}
      {groups.length > 1 && (
        <div class="mt-7">
          <div class="flex flex-wrap items-center gap-1.5" id="filters" role="group" aria-label="Filter by group">
            <button
              type="button"
              data-filter="all"
              aria-pressed="true"
              class="rounded-full border border-line px-2.5 py-1 text-[.78rem] text-muted hover:border-accent hover:text-fg aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-fg"
            >All {events.length}</button>
            {groups.map((g) => (
              <button
                type="button"
                data-filter={g.slug}
                aria-pressed="true"
                class="rounded-full border border-line px-2.5 py-1 text-[.78rem] text-muted hover:border-accent hover:text-fg aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-fg"
              >{g.name} {g.count}</button>
            ))}
          </div>
          {/* aria-live so a screen reader is told the list changed. The visual
              change is obvious; the announcement is the only signal otherwise. */}
          <p class="mt-2 text-[.8rem] text-muted" id="filter-status" aria-live="polite"></p>
        </div>
      )}

      {days.length === 0 ? (
        <div class="mt-8 rounded-lg border border-dashed border-line p-8 text-center text-muted">
          <p>Nothing upcoming.</p>
          <p class="mt-2">
            If that is a surprise, no group has been verified yet, so every event is still
            pending. Run <code>htxdev export -preview</code> to see what verifying them
            would publish.
          </p>
        </div>
      ) : (
        days.map((day) => (
          <section class="mt-9 scroll-mt-20" id={`day-${day.key}`} data-day={day.key}>
            <h2 class="mb-2 border-b border-line pb-1.5 text-xs font-semibold tracking-[.08em] text-muted uppercase">
              {day.label}
            </h2>
            {day.events.map((event) => <EventCard event={event} tz={TZ} />)}
          </section>
        ))
      )}

      <footer class="mt-12 border-t border-line pt-5 text-[.82rem] text-muted">
        <p>
          {events.length} event{events.length === 1 ? '' : 's'}, generated {generated} Houston time.
        </p>
        <p class="mt-2">
          Events belong to the groups that run them. htxdev reads their public calendars and
          links back. If you organise a Houston tech group and want to be listed, or want to
          not be, <a class="text-accent hover:underline" href="https://github.com/ileanmjr88/htxdev/issues/new/choose">say so here</a>.
        </p>
        {/* The same data this page was built from, as JSON. Worth saying out
            loud: the point of collecting this in one place is that somebody
            else can use it without scraping the page. */}
        <p class="mt-2">
          Building something with this? The data is at
          <a class="text-accent hover:underline" href="/api/v1/events.json"><code>/api/v1/events.json</code></a>,
          CORS open, no key.
          <a class="text-accent hover:underline" href="https://github.com/ileanmjr88/htxdev">Source on GitHub</a>.
        </p>
      </footer>
    </div>

    {/* Filtering, inline and dependency-free.

        State is the set of HIDDEN slugs, not the visible ones. That way a
        group added to the registry next month shows up for everyone who has
        used the filters before, instead of being invisible to exactly the
        people who use the site most.

        Every localStorage access is wrapped, because it throws rather than
        returning null in a locked-down browser, and a thrown filter would take
        the whole listing with it. */}
    <script is:inline>
      (() => {
        const bar = document.getElementById('filters');
        if (!bar) return;

        const KEY = 'htxdev-hidden-groups';
        const status = document.getElementById('filter-status');
        const cards = [...document.querySelectorAll('article[data-group]')];
        const days = [...document.querySelectorAll('section[data-day]')];
        const buttons = [...bar.querySelectorAll('button[data-filter]')];
        const all = buttons.filter((b) => b.dataset.filter !== 'all');

        let hidden = new Set();
        try {
          const raw = localStorage.getItem(KEY);
          if (raw) hidden = new Set(JSON.parse(raw));
        } catch {}

        const save = () => {
          try { localStorage.setItem(KEY, JSON.stringify([...hidden])); } catch {}
        };

        // A stored slug for a group that has since left the registry would
        // hide nothing and confuse the counts, so drop it on load, and write
        // the pruned list back so dead slugs do not accumulate across years of
        // registry churn.
        const known = new Set(all.map((b) => b.dataset.filter));
        let pruned = false;
        for (const slug of [...hidden]) {
          if (!known.has(slug)) { hidden.delete(slug); pruned = true; }
        }
        if (pruned) save();

        // Jump links point at a specific date heading. A filter can hide that
        // heading, and an anchor to a display:none element scrolls nowhere,
        // which reads as a dead link. So: land on the first visible day at or
        // after the target instead, and dim a link with nothing left after it.
        const jumpLinks = [...document.querySelectorAll('a[data-jump]')];
        const firstVisibleFrom = (key) =>
          days.find((d) => !d.hidden && (d.dataset.day ?? '') >= key) ?? null;

        for (const link of jumpLinks) {
          link.addEventListener('click', (ev) => {
            const target = firstVisibleFrom(link.dataset.jump);
            if (!target) { ev.preventDefault(); return; }
            // Only intercept when the anchor would not do the right thing on
            // its own, so normal clicks keep native behaviour and history.
            if (target.id !== `day-${link.dataset.jump}`) {
              ev.preventDefault();
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          });
        }

        const apply = () => {
          let shown = 0;
          for (const card of cards) {
            const on = !hidden.has(card.dataset.group);
            card.hidden = !on;
            if (on) shown++;
          }
          // A date heading with nothing under it reads as a bug.
          for (const day of days) {
            day.hidden = !day.querySelector('article[data-group]:not([hidden])');
          }
          for (const b of all) {
            b.setAttribute('aria-pressed', String(!hidden.has(b.dataset.filter)));
          }
          const allBtn = buttons.find((b) => b.dataset.filter === 'all');
          if (allBtn) allBtn.setAttribute('aria-pressed', String(hidden.size === 0));

          for (const link of jumpLinks) {
            const dead = !firstVisibleFrom(link.dataset.jump);
            link.setAttribute('aria-disabled', String(dead));
            link.classList.toggle('opacity-40', dead);
            link.classList.toggle('pointer-events-none', dead);
          }

          if (status) {
            status.textContent = hidden.size === 0
              ? ''
              : shown === 0
                ? 'No events match. Every group is filtered out.'
                : `Showing ${shown} of ${cards.length} events.`;
          }
        };

        bar.addEventListener('click', (e) => {
          const btn = e.target.closest('button[data-filter]');
          if (!btn) return;
          const slug = btn.dataset.filter;
          if (slug === 'all') {
            hidden.clear();
          } else if (hidden.has(slug)) {
            hidden.delete(slug);
          } else {
            hidden.add(slug);
          }
          save();
          apply();
        });

        apply();
      })();
    </script>
  </body>
</html>
