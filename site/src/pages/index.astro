---
import '../styles/global.css';
import EventCard from '../components/EventCard.astro';
import Wordmark from '../components/Wordmark.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { readEvents } from '../lib/events';

// Loaded from src/lib/events.ts, which this page and the /api/v1/events.json
// endpoint both use. The loader explains where it looks and why.
const data = readEvents();
const events = data.events;

// Every date and time on this page is rendered in America/Chicago, explicitly.
// The JSON carries UTC instants and a build machine is in whatever zone it
// feels like, so relying on the default would make the site show different
// days depending on where it was built. This is the same trap D10 describes on
// the Go side: an all-day event stored as midnight Chicago shows the previous
// date if it is ever rendered in UTC.
const TZ = 'America/Chicago';
const dayHeading = new Intl.DateTimeFormat('en-US', {
  weekday: 'long', month: 'long', day: 'numeric', timeZone: TZ,
});
// en-CA gives YYYY-MM-DD, which is what makes these sortable and groupable.
const dayKey = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric', month: '2-digit', day: '2-digit', timeZone: TZ,
});

const days = [];
for (const event of events) {
  const key = dayKey.format(new Date(event.start));
  const last = days.at(-1);
  if (last?.key === key) last.events.push(event);
  else days.push({ key, label: dayHeading.format(new Date(event.start)), events: [event] });
}

const generated = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'medium', timeStyle: 'short', timeZone: TZ,
}).format(new Date(data.generated_at));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>htxdev — Houston tech events</title>
    <meta
      name="description"
      content="Houston tech meetups and events, collected from the groups that run them."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* A preview build carries unverified data and must never be indexed if it
        somehow gets deployed. */}
    {data.preview && <meta name="robots" content="noindex, nofollow" />}

    {/* Before first paint, deliberately. Setting the attribute from the toggle
        component instead would mean the page renders in one theme and then
        swaps, which is the flash every site with a theme switcher gets wrong
        at least once. Small enough to stay inline; a request for it would
        reintroduce the flash it exists to prevent. */}
    <script is:inline>
      try {
        const t = localStorage.getItem('htxdev-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>

  <body>
    <div class="mx-auto max-w-2xl px-5 pt-10 pb-16">
      <header>
        <div class="flex items-center justify-between gap-4">
          <Wordmark as="a" class="text-xl sm:text-2xl" />
          <ThemeToggle />
        </div>

        <h1 class="mt-8 text-xl font-semibold tracking-tight sm:text-2xl">Houston tech events</h1>
        <p class="mt-1 text-muted">
          Collected from the groups that run them, so you only have to look in one place.
        </p>
      </header>

      {data.preview && (
        <div class="mt-6 rounded-lg border border-warn bg-warn-bg px-4 py-3 text-sm">
          <strong class="mb-1 block">Preview build — not for publishing.</strong>
          This page includes events from groups nobody has verified yet. A group is verified
          by a human reading its feed once and putting their name in <code>sources.yaml</code>,
          and until that happens these events are not publishable.
        </div>
      )}

      {days.length === 0 ? (
        <div class="mt-8 rounded-lg border border-dashed border-line p-8 text-center text-muted">
          <p>Nothing upcoming.</p>
          <p class="mt-2">
            If that is a surprise, no group has been verified yet, so every event is still
            pending. Run <code>htxdev export -preview</code> to see what verifying them
            would publish.
          </p>
        </div>
      ) : (
        days.map((day) => (
          <section class="mt-9">
            <h2 class="mb-2 border-b border-line pb-1.5 text-xs font-semibold tracking-[.08em] text-muted uppercase">
              {day.label}
            </h2>
            {day.events.map((event) => <EventCard event={event} tz={TZ} />)}
          </section>
        ))
      )}

      <footer class="mt-12 border-t border-line pt-5 text-[.82rem] text-muted">
        <p>
          {events.length} event{events.length === 1 ? '' : 's'}, generated {generated} Houston time.
        </p>
        <p class="mt-2">
          Events belong to the groups that run them. htxdev reads their public calendars and
          links back. If you organise a Houston tech group and want to be listed, or want to
          not be, <a class="text-accent hover:underline" href="https://github.com/ileanmjr88/htxdev/issues/new/choose">say so here</a>.
        </p>
      </footer>
    </div>
  </body>
</html>
