---
/* htxdev()
 *
 * Text, not an image: it scales, re-themes, reads aloud to a screen reader and
 * costs no request.
 *
 * It was func htxdev() {} first. The declaration was a better joke and a worse
 * mark. Two thirds of it was dimmed punctuation, and `func` only lands for Go
 * developers, which is the wrong audience to optimise for at the top of a
 * community utility whose registry has hardware, data and startup groups in it
 * alongside dev. The parens survive because they carry the same signal in an
 * eighth of the width, and because they happen to be true: this is a thing
 * that runs, twice a day.
 */
const { as: Tag = 'span', class: cls = '' } = Astro.props;
// An <a> needs somewhere to go; anything else must not have an href.
const href = Tag === 'a' ? '/' : undefined;
---

<Tag href={href} class:list={['font-mono whitespace-nowrap no-underline', cls]}
  ><span class="text-accent font-semibold">htxdev</span><span class="text-muted">()</span></Tag
>
