---
/* One promoted link. The page shows it twice: after the first day of events,
   and again just before the footer for whoever reads to the end. Takes its
   content as props and knows nothing about where it came from;
   src/lib/spotlight.ts decides that. `id` is for the page script, which has
   to tell the two copies apart. `placement` becomes utm_content on the link,
   so analytics can tell which copy got the click.

   A card so it gets seen, but tinted with the accent rather than drawn like
   an EventCard, and marked "Spotlight", so nobody mistakes it for an event. */
import type { SpotlightEntry } from '../lib/spotlight';

type Props = SpotlightEntry & { id?: string; placement?: string };
const { label, text, cta, url, byline, id, placement } = Astro.props;

const href = new URL(url);
if (placement) href.searchParams.set('utm_content', placement);
---

<aside
  id={id}
  aria-label="Spotlight"
  class="mt-6 rounded-lg border border-accent/40 bg-accent/5 px-4 py-4"
>
  <p class="text-[.7rem] font-semibold tracking-[.08em] text-muted uppercase">
    Spotlight{byline && <><span aria-hidden="true">{' '}·{' '}</span><span class="sr-only">, </span>{byline}</>}
  </p>
  <h2 class="mt-1 text-[1.05rem] leading-snug font-semibold">{label}</h2>
  <p class="mt-1 text-[.92rem] text-fg/85">{text}</p>
  <a
    class="mt-3 inline-block rounded-full border border-accent px-3 py-1 text-[.82rem] font-semibold text-accent hover:bg-accent/10"
    href={href.toString()}
  >{cta} →</a>
</aside>
