{
  // Cloudflare Workers Static Assets, not Pages. Cloudflare's own guidance as
  // of 2026 is that new projects start here: Pages stays supported but every
  // new feature goes to Workers, and static asset requests are free.
  //
  // There is no "main" script. A Worker that serves only static assets does
  // not need one, and adding an empty one would put a runtime in front of
  // files that do not need it.
  "name": "htxdev",
  "compatibility_date": "2026-09-18",

  // The custom domain, declared here rather than clicked into the dashboard,
  // so it is in git and every deploy reasserts it. Cloudflare creates the DNS
  // record and issues the certificate itself, and the record points straight
  // at this Worker.
  //
  // This is NOT the same as a CNAME to htxdev.ileanmjr.workers.dev. A proxied
  // CNAME makes Cloudflare treat workers.dev as an origin server, try to
  // connect to it, and time out with a 522. That was the first attempt.
  //
  // A Custom Domain cannot be created while a CNAME for the same hostname
  // exists, so if a deploy ever fails here, that record came back.
  // Explicit, because declaring routes turns this off by default and a silent
  // default is a bad reason for a URL to stop working. htxdev.ileanmjr.workers.dev
  // now returns Cloudflare error 1042, which is what a disabled subdomain looks
  // like from outside.
  //
  // Off is the right answer anyway: the site has one hostname, so there is no
  // second copy for a crawler to index and no second URL to keep in step. Flip
  // it to true if a staging URL is ever wanted.
  "workers_dev": false,

  "routes": [
    { "pattern": "htxdev.ilean.me", "custom_domain": true }
  ],

  "assets": {
    // Relative to this file, so the root directory in Workers Builds is site/.
    "directory": "./dist/",

    // Serves src/pages/404.astro for an unmatched path. Without that page this
    // setting has nothing to return.
    "not_found_handling": "404-page",

    // Matches Astro's build.format: 'directory'. A folder index is served with
    // a trailing slash, a standalone file without one, so there is one URL per
    // page rather than two that both work.
    "html_handling": "auto-trailing-slash"
  }
}
